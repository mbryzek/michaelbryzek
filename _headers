# Self-hosted fonts have content-stable filenames, so cache them aggressively.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The trip app is private and holds two people's plans. Keep it out of search
# indexes and out of shared caches; the shells carry no trip data, but a cached
# one is still a copy of something nobody asked to publish.
/trips/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: private, no-store
