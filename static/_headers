# Self-hosted fonts have content-stable filenames, so cache them aggressively.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# SvelteKit names every file under _app/immutable by a hash of its content, so a
# changed file is a new URL and none of these can ever go stale. Without this
# rule the host serves them with a 4-hour must-revalidate, which costs a repeat
# visitor a conditional request per chunk after every expiry.
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable
